# Токен Telegram-бота — получить у @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram ID администратора (доступ к /admin)
ADMIN_USER_ID=123456789

# Прокси, если сервер в РФ (необязательно)
# TELEGRAM_PROXY=http://127.0.0.1:2080

# Радиус поиска АЗС в градусах (~0.5 ≈ 55 км)
SEARCH_DELTA=0.5

# Сколько станций показывать в результатах
MAX_RESULTS=10